<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#F8FAFC">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/iconBox"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EFE7FF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_document"
                app:tint="#7C3AED"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvMedName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Paracetamol 500mg"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#0F172A"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/iconBox"
            app:layout_constraintTop_toTopOf="@id/iconBox"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvMedLine1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="1 tablet, 3 times daily"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/tvMedName"
            app:layout_constraintTop_toBottomOf="@id/tvMedName"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvMedLine2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="For 3 days"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@id/tvMedName"
            app:layout_constraintTop_toBottomOf="@id/tvMedLine1"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
